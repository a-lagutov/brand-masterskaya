# One file for the whole repo. A pattern without a leading slash matches
# in every folder (site, admin/, worker/), so each one is listed once.

# npm packages, restored by `npm ci`.
node_modules/

# Build output: the static site (scripts/build.mjs) and the Next.js admin panel.
/dist/
/admin/.next/
# Regenerated by Next.js and TypeScript on every run.
next-env.d.ts
*.tsbuildinfo

# Secrets. Templates .env.example and config.example.php stay tracked.
# Admin panel and bot settings.
.env
# Tochka payment keys; on hosting the deploy writes it to ~/private/<site>/.
config.php
# Worker secrets for `wrangler dev`, and its local state.
.dev.vars
.wrangler/

# Local SQLite database of the admin panel and its journal.
*.db
*.db-journal
# Files uploaded through the admin panel.
/admin/media/

# Husky helper scripts, recreated by `npm install`.
.husky/_/

# Local Claude Code settings and memory.
.claude/
# macOS folder metadata.
.DS_Store
