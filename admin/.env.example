# Local development; on the hosting the deploy passes these from ~/private/<admin site>/env.json.
DATABASE_URL=file:./dev.db
PAYLOAD_SECRET=any-long-random-string
# First admin, created when there are no admins yet.
ADMIN_EMAIL=dev@example.com
ADMIN_PASSWORD=dev-password
# Optional: the bot and the order sync run only with RUN_BOT=1, never alongside the hosting's copy.
TELEGRAM_BOT_TOKEN=
RUN_BOT=
ORDERS_DIR=
PRICES_FILE=
SITE_URL=https://test.brandmasterskaya.ru
