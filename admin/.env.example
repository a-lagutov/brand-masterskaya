# Local development; on the hosting the deploy passes these from ~/private/<admin site>/env.json.
DATABASE_URL=file:./dev.db
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
# First admin, created when there are no admins yet.
ADMIN_EMAIL=dev@example.com
ADMIN_PASSWORD=dev-password
# Optional: the bot and the order sync run only with RUN_BOT=1, never alongside the hosting's copy.
TELEGRAM_BOT_TOKEN=
# Link target for local previews without a token. Use the username of this environment's bot.
TELEGRAM_BOT_USERNAME=masterskaya_brand_test_bot
RUN_BOT=
# Bot API root; on the hosting the Cloudflare relay from worker/.
TELEGRAM_API_URL=
ORDERS_DIR=
PRICES_FILE=
# Where the panel writes prices and promo codes for the site (~/private/<site>/ on the hosting).
PRICE_OVERRIDES_FILE=
PROMO_CODES_FILE=
SITE_SETTINGS_FILE=
SITE_URL=https://test.brandmasterskaya.ru

# Student cabinet: landing-page origin, with separate secrets for each environment.
# Production: https://brandmasterskaya.ru; test: https://test.brandmasterskaya.ru
CABINET_URL=http://localhost:3000
CABINET_SECRET=
# OIDC credentials from the same environment's bot, BotFather > Login Widget.
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# Store outside public/ and the deployed app directory in production.
LECTURE_STORAGE_DIR=
# Enable only after FFmpeg and Shaka Packager are installed and verified.
RUN_LECTURE_WORKER=
FFMPEG_PATH=
SHAKA_PACKAGER_PATH=
